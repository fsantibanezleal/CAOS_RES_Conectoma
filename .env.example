# Example environment. Copy to .env (git-ignored) and fill. No secrets in this file, ever.
# This product is static replay, so none of these are needed unless the dormant app/ backend is activated.
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DEV_ORIGINS=http://localhost:5173
PROD_ORIGINS=
DATA_DIR=data/derived
# Local cache roots for the heavy inputs that never enter git (see data/README.md).
CONECTOMA_DATA_ROOT=
CONECTOMA_MODELS_ROOT=
